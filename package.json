  "type": "module",
  "scripts": {
    "all:test": "pnpm ts && pnpm lint",
    "build": "pnpm build:free",
    "build:free": "tsc && vite build",
    "clean": "pnpm bitapps-plugin-clean-node",
    "dev:free": "vite",
    "i18n": "pnpm bitapps-plugin-i18n",
    "lint": "eslint frontend --fix",
    "lint:css": "stylelint frontend/**/*.{css,scss} --aei --color --fix",
    "lint:php": "composer lint",
    "pre-commit": "lefthook run pre-commit",
    "pretty": "npx prettier ./frontend/src --check",
    "pretty:fix": "npx prettier ./frontend/src --check --write",
    "preview": "vite preview",
    "prod": "pnpm prod:free",
    "prod-zip": "pnpm prod:free-zip",
    "prod:free": "pnpm build:free && pnpm i18n && node ./scripts/generate-free-build.js",
    "prod:free-zip": "pnpm build:free && pnpm i18n && node ./scripts/generate-free-build.js --zip",
    "production": "composer install --no-dev && pnpm install && pnpm i18n && pnpm build",
    "reset": "pnpm clean && pnpm install",
    "sb": "storybook dev -p 6006",
    "test": "vitest --watch=false -c ./vite.config.ts",
    "test:": "vitest --inspect-brk --pool threads --poolOptions.threads.singleThread",
    "test:cover": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:watch": "vitest --watch=true",
    "ts-check": "tsc",
    "type-cov": "pnpx type-coverage -p ./tsconfig.json --strict --details",
    "update-ver": "pnpm bitapps-plugin-update-version --slug bit-crm"
